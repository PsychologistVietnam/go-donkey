{
  "name": "go-donkey",
  "version": "1.0.0",
  "description": "Go Donkey - Journey Tracking and Content Platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
"scripts": {
  "dev": "concurrently -k -n SERVER,CLIENT \"npm run dev:server\" \"npm run dev:client\"",
  "dev:server": "nodemon --exec \"node --env-file=.env\" server/server.js",
  "dev:client": "npm run dev --prefix client",
  "build": "npm run build --prefix client",
  "postinstall": "npm install --prefix client && npm run build --prefix client",
  "start": "node server/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PsychologistVietnam/go-donkey.git"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.11"
  }
}

